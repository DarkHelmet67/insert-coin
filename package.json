{
  "name": "insert-coin",
  "private": true,
  "type": "module",
  "description": "1980s coin-op arcade games rebuilt from scratch in TypeScript on HTML5 Canvas.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @arcade/space-invaders dev",
    "build": "pnpm -r --filter \"./games/*\" build",
    "typecheck": "pnpm -r exec tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-jsdoc": "^64.5.4",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
